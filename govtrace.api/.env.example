# =============================================================================
# GovTrace — variáveis de ambiente (NÃO commitar o arquivo .env real)
# Copie este arquivo:  cp .env.example .env
# =============================================================================

# --- Portal da Transparência (obrigatório para carga de emendas / MCP Python) ---
# Obtenha em: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=sua_chave_api_dados_aqui

# --- MySQL (Spring Boot + Docker Compose) ---
MYSQL_DATABASE=govtrace_db
MYSQL_ROOT_PASSWORD=defina_senha_forte_aqui
MYSQL_PORT=3307
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/govtrace_db?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC&rewriteBatchedStatements=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=defina_senha_forte_aqui

# --- IA — Groq (auditoria LangChain4j no backend Java) ---
GROQ_API_KEY=sua_chave_groq_aqui
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_NAME=llama-3.1-8b-instant

# --- IA — Gemini (opcional; use se migrar provider ou configurar no IDE) ---
# GOVTRACE_AI_GEMINI_API_KEY=sua_chave_gemini_aqui

# --- Kafka / MCP (URLs não sensíveis; podem ficar no application.properties) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
GOVTRACE_MCP_URL=http://localhost:8000/mcp
